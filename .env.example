# Optional. The deterministic engine needs NO keys.
GEMINI_API_KEY=
WORKERS_AI_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=

# Recommended in production: required for every POST under /api/*.
AGENT_TOKEN=

# Classification threshold. Tickets below this are routed to human review.
CONFIDENCE_THRESHOLD=0.72

# Local Node server port.
PORT=8788
